# With Docker:    copy this to .env in the project root
# Without Docker: copy this to backend/.env
#
# Then fill in your own values. Never commit the filled-in file.

# https://www.nutritionix.com/business/api - paid only, the free tier was retired
NUTRITIONIX_APP_ID=your_app_id
NUTRITIONIX_APP_KEY=your_app_key

# Free tier: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=your_api_key

# Docker Compose starts its own MongoDB, so leave MONGODB_URI unset there.
# Without Docker, point this at your local MongoDB or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/nutrient-tracker

# With Docker this is the host port you browse to (default 3100).
# Without Docker it is the port the Express server listens on (default 8080).
PORT=3100
